{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/blogs/layout,_N_T_/blogs/product/layout,_N_T_/blogs/product/page,_N_T_/blogs/product"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/blogs/product/__PAGE__",
    "/blogs/product",
    "/blogs",
    "/_index",
    "/_head"
  ]
}