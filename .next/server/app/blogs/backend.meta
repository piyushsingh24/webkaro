{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/blogs/layout,_N_T_/blogs/backend/layout,_N_T_/blogs/backend/page,_N_T_/blogs/backend"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/blogs/backend/__PAGE__",
    "/blogs/backend",
    "/blogs",
    "/_index",
    "/_head"
  ]
}