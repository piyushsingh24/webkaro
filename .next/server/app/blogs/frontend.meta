{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/blogs/layout,_N_T_/blogs/frontend/layout,_N_T_/blogs/frontend/page,_N_T_/blogs/frontend"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/blogs/frontend/__PAGE__",
    "/blogs/frontend",
    "/blogs",
    "/_index",
    "/_head"
  ]
}